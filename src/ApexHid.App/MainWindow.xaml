<Window x:Class="ApexHid.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ApexHid.Core.Controls;assembly=ApexHid.Core"
        Title="APEX-HID Suite"
        Width="1280"
        Height="810"
        MinWidth="1060"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        FlowDirection="{Binding Loc.CurrentFlowDirection}"
        FontFamily="{Binding Loc.PrimaryFontFamily}"
        Typography.NumeralAlignment="Tabular"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="54"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="1"
                      CornerRadius="16"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Seamless Unified "Arctic Liquid Glass" Canvas (Glacial Light #F2F8FC->#E3EFF8->#D6E7F4 | Arctic Dark #060B12->#0A1320->#070E18) -->
    <Grid Background="{DynamicResource WindowCanvasBrush}">
        <!-- Subtle Icy Radial Ambient Glows (#7DD3FC at 18% opacity in Glacial Light) -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="680" Height="440" Canvas.Left="-140" Canvas.Top="-120"
                     Fill="{DynamicResource AmbientGlowTopLeftBrush}" />
            <Ellipse Width="720" Height="500" Canvas.Right="-160" Canvas.Bottom="-160"
                     Fill="{DynamicResource AmbientGlowBottomRightBrush}" />
        </Canvas>

        <Grid Margin="18,10,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- SEAMLESS TOP BAR (Zero Harsh Dividers or Boxed Titlebars) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10"
                            Background="{DynamicResource AppleAccentGradientBrush}"
                            BorderBrush="#77FFFFFF" BorderThickness="1"
                            Margin="0,0,12,0">
                        <TextBlock Text="◈" FontSize="17" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Loc[AppTitle]}" FontSize="15.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Border CornerRadius="6"
                                    Background="{DynamicResource SubCardSurfaceBrush}"
                                    BorderBrush="{DynamicResource SubCardBorderBrush}"
                                    BorderThickness="1"
                                    Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.4.0 · WHQL" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource AppleBlueBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Loc[AppSubtitle]}" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Center Live Polling Telemetry Pill (Tabular Numerals) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        FlowDirection="LeftToRight"
                        CornerRadius="14" Padding="14,6"
                        Background="{DynamicResource TopPillSurfaceBrush}"
                        BorderBrush="{DynamicResource SpecularBorderBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="TopPulseDot" Width="8" Height="8" Fill="{DynamicResource AppleAmberBrush}" Margin="0,0,9,0" />
                        <TextBlock x:Name="TopActiveModelText" Text="No Controller Connected" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" />
                        <Border Width="1" Height="13" Background="{DynamicResource SubCardBorderBrush}" Margin="0,0,12,0" />
                        <TextBlock x:Name="TopLiveRateText" Text="0 Hz / Waiting for Controller" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AppleBlueBrush}"
                                   Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                </Border>

                <!-- Top-Right Arctic Theme Switcher ("Glacial Light ❄️ | Arctic Dark 🌑"), Bilingual Toggle ("العربية | EN") & Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggleBtn"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource SecondaryGlassButtonStyle}"
                            Padding="13,7"
                            Margin="0,0,10,0"
                            Click="OnToggleThemeClick">
                        <TextBlock Text="{Binding Theme.ThemeToggleLabel}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </Button>

                    <Button x:Name="LanguageToggleBtn"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource SecondaryGlassButtonStyle}"
                            Padding="13,7"
                            Margin="0,0,12,0"
                            Click="OnToggleLanguageClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Loc[LangToggleText]}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource WindowControlButtonStyle}" Content="─" Click="OnMinimizeClick" />
                    <Button Style="{StaticResource WindowControlButtonStyle}" Content="▢" Click="OnMaximizeRestoreClick" Margin="2,0" />
                    <Button Style="{StaticResource WindowControlButtonStyle}" Content="✕" Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <!-- MAIN SEAMLESS WORKSPACE (Sidebar + Animated Page Viewport) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="268" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR WITH FLOATING GLASS INDICATOR PILL -->
                <controls:LiquidGlassCard Grid.Column="0" CornerRadius="18" CardPadding="14" InteractiveScale="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Navigation Menu Stack with Gliding Glass Indicator Pill -->
                        <Grid Grid.Row="0" Margin="0,4,0,0">
                            <Border x:Name="SidebarIndicatorPill"
                                    Height="46"
                                    VerticalAlignment="Top"
                                    CornerRadius="12"
                                    Background="{DynamicResource SidebarPillSurfaceBrush}"
                                    BorderBrush="{DynamicResource SubCardBorderBrush}"
                                    BorderThickness="1">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="PillTranslateTransform" Y="0" />
                                </Border.RenderTransform>
                                <Grid>
                                    <Border Width="3.5" Height="22" CornerRadius="2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Margin="6,0,0,0"
                                            Background="{DynamicResource AppleAccentGradientBrush}" />
                                </Grid>
                            </Border>

                            <StackPanel>
                                <Button x:Name="NavBtn0" Tag="0" Height="46" Margin="0,0,0,6"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Click="OnSidebarNavClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" Padding="18,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,11,0" Foreground="{DynamicResource AppleBlueBrush}" />
                                                    <TextBlock Text="{Binding Loc[NavDashboard]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="NavBtn1" Tag="1" Height="46" Margin="0,0,0,6"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Click="OnSidebarNavClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" Padding="18,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="〰" FontSize="14" Margin="0,0,11,0" Foreground="{DynamicResource AppleIndigoBrush}" />
                                                    <TextBlock Text="{Binding Loc[NavOscilloscope]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="NavBtn2" Tag="2" Height="46" Margin="0,0,0,6"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Click="OnSidebarNavClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" Padding="18,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="◎" FontSize="14" Margin="0,0,11,0" Foreground="{DynamicResource AppleGreenBrush}" />
                                                    <TextBlock Text="{Binding Loc[NavCalibration]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="NavBtn3" Tag="3" Height="46" Margin="0,0,0,0"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Click="OnSidebarNavClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" Padding="18,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🛡" FontSize="14" Margin="0,0,11,0" Foreground="{DynamicResource AppleAmberBrush}" />
                                                    <TextBlock Text="{Binding Loc[NavSystemShield]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Bottom Quick Telemetry & Real Anti-Cheat Mini Summary inside Sidebar -->
                        <Border Grid.Row="2" CornerRadius="14" Padding="14"
                                Background="{DynamicResource SubCardSurfaceBrush}"
                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ANTI-CHEAT PRE-FLIGHT" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Secure Boot" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="SidebarSecureBootText" Text="ON · VERIFIED" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AppleGreenBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="HVCI Memory Guard" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="SidebarHvciText" Text="ON · ACTIVE" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AppleGreenBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Test Signing" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="SidebarTestSignText" Text="OFF · WHQL" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AppleBlueBrush}" HorizontalAlignment="Right" />
                                </Grid>

                                <Border Height="1" Background="{DynamicResource SubCardBorderBrush}" Margin="0,2,0,8" />
                                <TextBlock x:Name="SidebarPacketCounterText"
                                           Text="WM_INPUT Packets: 0"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </controls:LiquidGlassCard>

                <!-- RIGHT WORKSPACE PAGE HOST WITH CUBIC-BEZIER(0.22, 1, 0.36, 1) TRANSITION -->
                <Grid x:Name="PageViewportHost" Grid.Column="2">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="PageSlideTransform" Y="0" />
                    </Grid.RenderTransform>

                    <!-- ==================== PAGE 0: CONTROLLER, SERIAL LOCK & AUTHENTICITY (LAYERS 1, 2, 3) ==================== -->
                    <ScrollViewer x:Name="Page0Dashboard" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.15*" />
                                </Grid.ColumnDefinitions>

                                <!-- LAYER 1: Real Physical Multi-Revision Sony Controller Detection Card -->
                                <controls:LiquidGlassCard Grid.Column="0" CornerRadius="18" CardPadding="22">
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,12">
                                            <Grid>
                                                <TextBlock Text="LAYER 1 · SETUPAPI &amp; WM_DEVICECHANGE" FontSize="10.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource AppleBlueBrush}" VerticalAlignment="Center" />
                                                <Border x:Name="HardwareSourceBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        CornerRadius="8" Padding="9,3"
                                                        Background="{DynamicResource SubCardSurfaceBrush}"
                                                        BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock x:Name="HardwareSourceText" Text="{Binding Loc[ConnectionModeDisconnected]}"
                                                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppleAmberBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Loc[DetectedHardwareTitle]}" FontSize="17" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0" />
                                        </StackPanel>

                                        <!-- Hardware Specs Table -->
                                        <Border CornerRadius="12"
                                                Background="{DynamicResource SubCardSurfaceBrush}"
                                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                BorderThickness="1" Padding="14" Margin="0,0,0,16">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Loc[ModelLabel]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                    <TextBlock Grid.Column="2" x:Name="ControllerModelValue" Text="No Controller Connected"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Loc[BoardRevisionLabel]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                    <TextBlock Grid.Column="2" x:Name="BoardRevisionValue" Text="Waiting for USB/HID Device..."
                                                               Foreground="{DynamicResource AppleBlueBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <TextBlock Text="{Binding Loc[VidPidLabel]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                    <TextBlock x:Name="VidPidValue" Text="—"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"
                                                               Typography.NumeralAlignment="Tabular" />
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <TextBlock Text="{Binding Loc[SerialNumberLabel]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                    <TextBlock x:Name="SerialNumberValue" Text="—"
                                                               Foreground="{DynamicResource AppleGreenBrush}" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Right"
                                                               Typography.NumeralAlignment="Tabular" />
                                                </Grid>
                                                <Grid Margin="0,0,0,9">
                                                    <TextBlock Text="{Binding Loc[FirmwareLabel]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                    <TextBlock x:Name="FirmwareValue" Text="—"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Loc[USBIntervalLabel]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                                    <TextBlock Grid.Column="2" x:Name="UsbBIntervalValue" Text="Waiting for Hardware"
                                                               Foreground="{DynamicResource AppleBlueBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <WrapPanel>
                                            <Button Style="{StaticResource SecondaryGlassButtonStyle}"
                                                    Content="{Binding Loc[ScanControllersBtn]}"
                                                    Margin="0,0,10,8"
                                                    Click="OnRescanControllersClick" />
                                            <Button Style="{StaticResource PrimaryGlassButtonStyle}"
                                                    Content="{Binding Loc[ProvisionWhqlBtn]}"
                                                    Margin="0,0,0,8"
                                                    Click="OnProvisionWhqlDriverClick" />
                                        </WrapPanel>
                                    </StackPanel>
                                </controls:LiquidGlassCard>

                                <!-- LAYER 2: Real Serial-Locked 1000Hz Overclocking Vault Card -->
                                <controls:LiquidGlassCard Grid.Column="2" CornerRadius="18" CardPadding="22">
                                    <StackPanel>
                                        <TextBlock Text="LAYER 2 · SETUPAPI LOWERFILTERS &amp; DIF_PROPERTYCHANGE" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource AppleIndigoBrush}" />
                                        <TextBlock Text="{Binding Loc[SerialLockTitle]}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,6" />
                                        <TextBlock Text="{Binding Loc[SerialLockSubtitle]}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                                        <!-- Active Lock Status Banner -->
                                        <Border x:Name="SerialLockStatusBanner"
                                                CornerRadius="12" Padding="14,10" Margin="0,0,0,14"
                                                Background="{DynamicResource SubCardSurfaceBrush}"
                                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse x:Name="SerialLockDot" Width="9" Height="9" Fill="{DynamicResource AppleAmberBrush}" Margin="0,0,10,0" />
                                                    <TextBlock x:Name="SerialLockBannerText"
                                                               Text="{Binding Loc[StatusDisconnectedLock]}"
                                                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppleAmberBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock x:Name="SerialLockHashText"
                                                           Text="SetupAPI LowerFilters: Waiting for physical controller"
                                                           FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="19,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Authorize / Revoke Current Controller Serial Buttons -->
                                        <WrapPanel Margin="0,0,0,10">
                                            <Button x:Name="AuthorizeSerialBtn"
                                                    Style="{StaticResource PrimaryGlassButtonStyle}"
                                                    Content="{Binding Loc[RegisterSerialBtn]}"
                                                    Margin="0,0,10,8"
                                                    Click="OnAuthorizeCurrentSerialClick" />
                                            <Button x:Name="RevokeSerialBtn"
                                                    Style="{StaticResource SecondaryGlassButtonStyle}"
                                                    Content="{Binding Loc[RevokeSerialBtn]}"
                                                    Margin="0,0,0,8"
                                                    Click="OnRevokeCurrentSerialClick" />
                                        </WrapPanel>

                                        <!-- Add Custom Serial to Vault -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CustomSerialInputBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource LiquidGlassTextBoxStyle}"
                                                     Text="" />
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryGlassButtonStyle}"
                                                    Content="{Binding Loc[AddSerialBtn]}"
                                                    Click="OnAddCustomSerialClick" />
                                        </Grid>

                                        <TextBlock Text="{Binding Loc[RegisteredVaultHeader]}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                        <ItemsControl x:Name="AuthorizedSerialsList" ItemsSource="{Binding SerialEngine.AuthorizedSerials}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="8"
                                                            Background="{DynamicResource SubCardSurfaceBrush}"
                                                            BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                            BorderThickness="1"
                                                            Padding="10,4" Margin="0,0,8,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🔒 " FontSize="11" Foreground="{DynamicResource AppleBlueBrush}" />
                                                            <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </controls:LiquidGlassCard>
                            </Grid>

                            <!-- LAYER 3: Real Hardware Chipset Authenticity Detector Card -->
                            <controls:LiquidGlassCard CornerRadius="18" CardPadding="22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="LAYER 3 · SILICON &amp; ENDPOINT TIMING AUTHENTICITY" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource AppleGreenBrush}" />
                                        <TextBlock Text="{Binding Loc[AuthenticityTitle]}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,5" />
                                        <TextBlock Text="{Binding Loc[AuthenticitySubtitle]}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                                        <Border x:Name="AuthenticityVerdictBanner"
                                                CornerRadius="12" Padding="14,11" Margin="0,0,0,14"
                                                Background="{DynamicResource SubCardSurfaceBrush}"
                                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                BorderThickness="1">
                                            <TextBlock x:Name="AuthenticityVerdictText"
                                                       Text="{Binding Loc[VerdictNoDevice]}"
                                                       FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AppleBlueBrush}" />
                                        </Border>

                                        <WrapPanel VerticalAlignment="Center">
                                            <Button Style="{StaticResource PrimaryGlassButtonStyle}"
                                                    Content="{Binding Loc[RunAuthenticityBtn]}"
                                                    Margin="0,0,16,6"
                                                    Click="OnRunAuthenticityVerifyClick" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="14"
                                            Background="{DynamicResource SubCardSurfaceBrush}"
                                            BorderBrush="{DynamicResource SubCardBorderBrush}"
                                            BorderThickness="1" Padding="16">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Loc[McuSignatureLabel]}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock x:Name="McuSignatureValue"
                                                       Text="No Physical Controller Connected"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" Margin="0,3,0,12" />

                                            <TextBlock Text="{Binding Loc[DescriptorProofLabel]}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock x:Name="DescriptorProofValue"
                                                       Text="Connect a physical Sony DualShock 4 or DualSense controller via USB."
                                                       FontSize="12" Foreground="{DynamicResource AppleBlueBrush}"
                                                       TextWrapping="Wrap" Margin="0,3,0,12" />

                                            <Grid>
                                                <TextBlock Text="{Binding Loc[ConfidenceScoreLabel]}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ConfidenceScoreValue" Text="0.0%"
                                                           FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppleGreenBrush}"
                                                           HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </controls:LiquidGlassCard>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== PAGE 1: MICROSECOND OSCILLOSCOPE & CIRCULARITY HEATMAP (LAYER 6) ==================== -->
                    <ScrollViewer x:Name="Page1Oscilloscope" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 4 Live Tabular Telemetry Metric Cards -->
                            <UniformGrid Columns="4" Margin="0,0,0,16">
                                <controls:LiquidGlassCard CornerRadius="16" CardPadding="18,14" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Loc[LivePollingHzLabel]}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock x:Name="MetricPollingHzText" Text="0 Hz" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppleBlueBrush}"
                                                   Margin="0,4,0,2" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock x:Name="MetricPollingLockSub" Text="Waiting for Controller" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </controls:LiquidGlassCard>

                                <controls:LiquidGlassCard CornerRadius="16" CardPadding="18,14" Margin="5,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Loc[PacketDeltaMsLabel]}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock x:Name="MetricDeltaMsText" Text="0.000 ms" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,4,0,2" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Text="QueryPerformanceCounter" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </controls:LiquidGlassCard>

                                <controls:LiquidGlassCard CornerRadius="16" CardPadding="18,14" Margin="5,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Loc[JitterVarianceUsLabel]}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock x:Name="MetricJitterUsText" Text="±0.0 µs" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppleGreenBrush}"
                                                   Margin="0,4,0,2" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Text="Microsecond Std-Dev" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </controls:LiquidGlassCard>

                                <controls:LiquidGlassCard CornerRadius="16" CardPadding="18,14" Margin="10,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Loc[P99LatencyMsLabel]}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock x:Name="MetricP99MsText" Text="0.000 ms" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppleIndigoBrush}"
                                                   Margin="0,4,0,2" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Text="WM_INPUT Hardware Stream" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </controls:LiquidGlassCard>
                            </UniformGrid>

                            <!-- Oscilloscope Waveform + 360° Polar Stick Circularity Heatmap -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.45*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="0.95*" />
                                </Grid.ColumnDefinitions>

                                <!-- 60fps QPC Waveform Card -->
                                <controls:LiquidGlassCard Grid.Column="0" CornerRadius="18" CardPadding="22" InteractiveScale="False">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="60FPS REAL-TIME WM_INPUT + QPC OSCILLOSCOPE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AppleBlueBrush}" />
                                                <TextBlock Text="{Binding Loc[WaveformGraphHeader]}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button x:Name="PauseResumeOscBtn"
                                                        Style="{StaticResource SecondaryGlassButtonStyle}"
                                                        Content="{Binding Loc[PauseTelemetryBtn]}"
                                                        Padding="12,6" Margin="0,0,8,0"
                                                        Click="OnPauseResumeOscilloscopeClick" />
                                                <Button Style="{StaticResource SecondaryGlassButtonStyle}"
                                                        Content="{Binding Loc[ResetStatsBtn]}"
                                                        Padding="12,6"
                                                        Click="OnResetOscilloscopeClick" />
                                            </StackPanel>
                                        </Grid>

                                        <controls:OscilloscopeGraphControl x:Name="OscilloscopeWaveformView" Height="310" />
                                    </StackPanel>
                                </controls:LiquidGlassCard>

                                <!-- 360° Polar Stick Circularity Heatmap Card -->
                                <controls:LiquidGlassCard Grid.Column="2" CornerRadius="18" CardPadding="22" InteractiveScale="False">
                                    <StackPanel>
                                        <TextBlock Text="36-SECTOR POLAR RADAR" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AppleIndigoBrush}" />
                                        <TextBlock Text="{Binding Loc[CircularityGraphHeader]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,12" />

                                        <controls:CircularityHeatmapControl x:Name="CircularityHeatmapView" Height="250" />

                                        <Border CornerRadius="10"
                                                Background="{DynamicResource SubCardSurfaceBrush}"
                                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                BorderThickness="1"
                                                Padding="12,9" Margin="0,12,0,0">
                                            <Grid>
                                                <TextBlock Text="{Binding Loc[CircularityAvgErrorLabel]}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="LiveCircularityErrorText" Text="0.00%"
                                                           FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource AppleGreenBrush}"
                                                           HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </controls:LiquidGlassCard>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== PAGE 2: NVS FLASH CALIBRATION (LAYER 5) ==================== -->
                    <ScrollViewer x:Name="Page2Calibration" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <controls:LiquidGlassCard CornerRadius="18" CardPadding="24" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="LAYER 5 · DIRECT HID FEATURE REPORTS (0x82 / 0x83)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AppleGreenBrush}" />
                                    <TextBlock Text="{Binding Loc[CalibrationTitle]}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,5" />
                                    <TextBlock Text="{Binding Loc[CalibrationSubtitle]}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />

                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Stick Telemetry Box -->
                                        <Border Grid.Column="0" CornerRadius="14"
                                                Background="{DynamicResource SubCardSurfaceBrush}"
                                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                BorderThickness="1" Padding="18">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Loc[LeftStickHeader]}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppleBlueBrush}" Margin="0,0,0,10" />
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Measured Center Drift" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
                                                    <TextBlock x:Name="LeftDriftValueText" Text="0.00%" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Measured Circularity Error" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
                                                    <TextBlock x:Name="LeftCircErrorValueText" Text="0.00%" Foreground="{DynamicResource AppleAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Grid>
                                                    <TextBlock Text="HID Transport" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
                                                    <TextBlock Text="HidD_SetFeature (0x82 / 0x83)" Foreground="{DynamicResource AppleGreenBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Right Stick Telemetry Box -->
                                        <Border Grid.Column="2" CornerRadius="14"
                                                Background="{DynamicResource SubCardSurfaceBrush}"
                                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                BorderThickness="1" Padding="18">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Loc[RightStickHeader]}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppleIndigoBrush}" Margin="0,0,0,10" />
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Measured Center Drift" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
                                                    <TextBlock x:Name="RightDriftValueText" Text="0.00%" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Measured Circularity Error" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
                                                    <TextBlock x:Name="RightCircErrorValueText" Text="0.00%" Foreground="{DynamicResource AppleAmberBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Grid>
                                                    <TextBlock Text="HID Transport" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" />
                                                    <TextBlock Text="HidD_SetFeature (0x82 / 0x83)" Foreground="{DynamicResource AppleGreenBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Status Banner -->
                                    <Border x:Name="NvsStatusBanner" CornerRadius="12" Padding="16,12" Margin="0,0,0,18"
                                            Background="{DynamicResource SubCardSurfaceBrush}"
                                            BorderBrush="{DynamicResource SubCardBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="NvsCalibrationStatusText"
                                                       Text="{Binding Loc[NvsWriteStatusIdle]}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppleBlueBrush}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="NvsFeatureReportHexText"
                                                       Text="HID Report: Idle — No Feature Report Sent"
                                                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"
                                                       Typography.NumeralAlignment="Tabular" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Calibration Action Steps -->
                                    <WrapPanel>
                                        <Button Style="{StaticResource SecondaryGlassButtonStyle}"
                                                Content="{Binding Loc[SampleCenterBtn]}"
                                                Margin="0,0,10,8"
                                                Click="OnSampleStickCenterClick" />
                                        <Button Style="{StaticResource SecondaryGlassButtonStyle}"
                                                Content="{Binding Loc[CalibrateRangeBtn]}"
                                                Margin="0,0,10,8"
                                                Click="OnCalibrateRangeClick" />
                                        <Button Style="{StaticResource PrimaryGlassButtonStyle}"
                                                Content="{Binding Loc[CommitNvsFlashBtn]}"
                                                Margin="0,0,10,8"
                                                Click="OnCommitNvsFlashClick" />
                                        <Button Style="{StaticResource SecondaryGlassButtonStyle}"
                                                Content="{Binding Loc[ResetFactoryNvsBtn]}"
                                                Margin="0,0,0,8"
                                                Click="OnQueryNvsStateClick" />
                                    </WrapPanel>
                                </StackPanel>
                            </controls:LiquidGlassCard>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== PAGE 3: USB POWER, MMCSS & ANTI-CHEAT SHIELD (LAYERS 4 & 7) ==================== -->
                    <ScrollViewer x:Name="Page3SystemShield" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- LAYER 4: USB Selective Suspend & MMCSS Thread Priority Optimizer -->
                            <controls:LiquidGlassCard CornerRadius="18" CardPadding="22" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="LAYER 4 · KERNEL USB POWER &amp; AVRT MMCSS SCHEDULER" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AppleBlueBrush}" />
                                    <TextBlock Text="{Binding Loc[UsbMmcssTitle]}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,5" />
                                    <TextBlock Text="{Binding Loc[UsbMmcssSubtitle]}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                                    <UniformGrid Columns="3" Margin="0,0,0,16">
                                        <Border CornerRadius="12"
                                                Background="{DynamicResource SubCardSurfaceBrush}"
                                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                BorderThickness="1" Padding="14" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Loc[UsbSelectiveSuspendLabel]}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="UsbSuspendStatusText" Text="{Binding Loc[UsbSuspendDisabledBadge]}"
                                                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppleGreenBrush}" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border CornerRadius="12"
                                                Background="{DynamicResource SubCardSurfaceBrush}"
                                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                BorderThickness="1" Padding="14" Margin="4,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Loc[MmcssThreadLabel]}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Loc[MmcssActiveBadge]}"
                                                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppleBlueBrush}" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border CornerRadius="12"
                                                Background="{DynamicResource SubCardSurfaceBrush}"
                                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                BorderThickness="1" Padding="14" Margin="8,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Loc[TimerResolutionLabel]}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="TimerResolutionValueText" Text="1.000 ms (timeBeginPeriod=1)"
                                                           FlowDirection="LeftToRight"
                                                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AppleIndigoBrush}" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <WrapPanel>
                                        <Button Style="{StaticResource PrimaryGlassButtonStyle}"
                                                Content="{Binding Loc[ApplyUsbOptimizationBtn]}"
                                                Margin="0,0,10,0"
                                                Click="OnApplyUsbOptimizationClick" />
                                        <Button Style="{StaticResource SecondaryGlassButtonStyle}"
                                                Content="{Binding Loc[RestoreDefaultUsbBtn]}"
                                                Click="OnRestoreDefaultUsbClick" />
                                    </WrapPanel>
                                </StackPanel>
                            </controls:LiquidGlassCard>

                            <!-- LAYER 7: Anti-Cheat Pre-Flight Shield -->
                            <controls:LiquidGlassCard CornerRadius="18" CardPadding="22">
                                <StackPanel>
                                    <TextBlock Text="LAYER 7 · KERNEL CODE-INTEGRITY &amp; ANTI-CHEAT PRE-FLIGHT SHIELD" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AppleGreenBrush}" />
                                    <TextBlock Text="{Binding Loc[AntiCheatTitle]}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,5" />
                                    <TextBlock Text="{Binding Loc[AntiCheatSubtitle]}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                                    <UniformGrid Columns="3" Margin="0,0,0,16">
                                        <Border CornerRadius="14"
                                                Background="{DynamicResource SubCardSurfaceBrush}"
                                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                BorderThickness="1" Padding="16" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Loc[SecureBootBadgeTitle]}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="CardSecureBootText" Text="{Binding Loc[BadgeSecureBootOn]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppleGreenBrush}" Margin="0,4,0,2" />
                                                <TextBlock Text="HKLM\SecureBoot\State" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <Border CornerRadius="14"
                                                Background="{DynamicResource SubCardSurfaceBrush}"
                                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                BorderThickness="1" Padding="16" Margin="4,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Loc[HvciBadgeTitle]}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="CardHvciText" Text="{Binding Loc[BadgeHvciOn]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppleGreenBrush}" Margin="0,4,0,2" />
                                                <TextBlock Text="VBS Hypervisor Code Integrity" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <Border CornerRadius="14"
                                                Background="{DynamicResource SubCardSurfaceBrush}"
                                                BorderBrush="{DynamicResource SubCardBorderBrush}"
                                                BorderThickness="1" Padding="16" Margin="8,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Loc[TestSigningBadgeTitle]}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock x:Name="CardTestSignText" Text="{Binding Loc[BadgeTestSigningOff]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppleBlueBrush}" Margin="0,4,0,2" />
                                                <TextBlock Text="NtQuerySystemInformation(0x67)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Grid>
                                        <WrapPanel VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryGlassButtonStyle}"
                                                    Content="{Binding Loc[RefreshSecurityBtn]}"
                                                    Margin="0,0,10,0"
                                                    Click="OnRefreshSecurityShieldClick" />
                                            <Button Style="{StaticResource PrimaryGlassButtonStyle}"
                                                    Content="{Binding Loc[CheckUpdatesBtn]}"
                                                    Click="OnCheckGitHubUpdateClick" />
                                        </WrapPanel>
                                        <TextBlock x:Name="GitHubUpdateStatusText"
                                                   FlowDirection="LeftToRight"
                                                   Text="GitHub Release Channel: v1.4.0 (Up to Date)"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </controls:LiquidGlassCard>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
