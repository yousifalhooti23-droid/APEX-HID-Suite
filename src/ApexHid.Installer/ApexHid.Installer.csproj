<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>APEX-HID-Setup</AssemblyName>
    <RootNamespace>ApexHid.Installer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.4.0</Version>
    <Company>APEX Precision Hardware Systems</Company>
    <Product>APEX-HID Setup &amp; Download Manager</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApexHid.Core\ApexHid.Core.csproj" />
  </ItemGroup>

</Project>
